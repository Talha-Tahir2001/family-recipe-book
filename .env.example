# ---- ElevenLabs (speech-to-text + text-to-speech) ----
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice for Cook Mode narration. Free-tier accounts must use a "premade" voice —
# professional/library voices return 402 paid_plan_required. List yours with:
#   npm run voices
# George ("Warm, Captivating Storyteller") suits recipe narration:
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2
ELEVENLABS_STT_MODEL_ID=scribe_v2

# ---- Google AI Studio (Gemma extraction + embeddings) ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Open-weight Gemma via the Gemini API. Swap freely — this is the open-model win.
# Check what your key can reach: GET /v1beta/models?pageSize=200
GEMMA_MODEL_ID=gemma-4-31b-it
GEMMA_FALLBACK_MODEL_ID=gemma-4-26b-a4b-it
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ---- MongoDB Atlas (M0 free tier) ----
# Atlas UI -> Clusters -> Connect -> Drivers. Keep the password URL-encoded.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=Family-Recipe-Book
# Some networks refuse the SRV lookup Atlas needs (querySrv ECONNREFUSED).
# 1) Point Node at public DNS:  DNS_SERVERS=1.1.1.1,8.8.8.8
# 2) If that is still refused (seen on Windows + Next dev), use the legacy
#    non-SRV string from Atlas -> Connect -> Drivers and put it here instead:
#      mongodb://<user>:<password>@<shard-host>:27017/<db>?tls=true&authSource=admin&directConnection=true

# ---- Local storage ----
UPLOAD_DIR=./uploads
TTS_CACHE_DIR=./cache/tts
MAX_UPLOAD_BYTES=52428800